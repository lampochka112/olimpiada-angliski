<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>✦ КОСМИЧЕСКИЕ ПАРЫ ✦</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root { --cyan: #22d3ee; --purple: #c084fc; --pink: #f472b6; --gold: #fbbf24; --bg: #020010; --card-radius: 1rem; }
    body {
      font-family: 'Orbitron', sans-serif;
      background: var(--bg);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      padding: 0.5rem;
      position: relative;
      overflow-x: hidden;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    body::before {
      content: ""; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(ellipse at 50% 40%, rgba(34,211,238,0.08), transparent 60%), radial-gradient(ellipse at 80% 20%, rgba(192,132,252,0.06), transparent 50%);
      animation: bgPulse 8s ease-in-out infinite alternate;
    }
    @keyframes bgPulse { 0% { opacity: 0.6; } 100% { opacity: 1; } }
    .stars {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: radial-gradient(1px 1px at 10% 20%, #fff, transparent), radial-gradient(1px 1px at 30% 60%, #fff, transparent), radial-gradient(1.5px 1.5px at 50% 30%, #fff, transparent), radial-gradient(1px 1px at 70% 70%, #fff, transparent), radial-gradient(1.5px 1.5px at 85% 40%, #fff, transparent), radial-gradient(1px 1px at 20% 85%, #fff, transparent), radial-gradient(1px 1px at 60% 15%, #fff, transparent), radial-gradient(1.5px 1.5px at 40% 55%, #fff, transparent);
      background-size: 200px 200px; opacity: 0.5; animation: twinkle 4s ease-in-out infinite alternate;
    }
    @keyframes twinkle { 0% { opacity: 0.3; } 100% { opacity: 0.7; } }

    #loading-screen {
      position: fixed; inset: 0; background: #000; z-index: 999; display: flex;
      flex-direction: column; justify-content: center; align-items: center;
      transition: opacity 0.8s, visibility 0.8s;
    }
    .loader-orbit { width: 180px; height: 180px; position: relative; }
    .loader-sun {
      width: 45px; height: 45px; background: radial-gradient(circle, #ffdd55, #ff7700);
      border-radius: 50%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      box-shadow: 0 0 50px #ffaa00; animation: sunPulse 2s infinite;
    }
    @keyframes sunPulse { 0%,100% { box-shadow: 0 0 50px #ffaa00; } 50% { box-shadow: 0 0 80px #ffcc44; } }
    .orbit { position: absolute; border-radius: 50%; border: 1px solid rgba(255,255,255,0.1); animation: spin linear infinite; }
    .orbit1 { width: 80px; height: 80px; top: 50%; left: 50%; transform: translate(-50%, -50%); animation-duration: 3s; }
    .orbit1::after { content: ''; position: absolute; top: 5px; left: 50%; width: 7px; height: 7px; background: #38bdf8; border-radius: 50%; box-shadow: 0 0 10px #38bdf8; }
    .orbit2 { width: 130px; height: 130px; top: 50%; left: 50%; transform: translate(-50%, -50%); animation-duration: 5s; animation-direction: reverse; }
    .orbit2::after { content: ''; position: absolute; top: 12px; left: 20%; width: 9px; height: 9px; background: #c084fc; border-radius: 50%; box-shadow: 0 0 12px #c084fc; }
    .orbit3 { width: 180px; height: 180px; top: 50%; left: 50%; transform: translate(-50%, -50%); animation-duration: 7s; }
    .orbit3::after { content: ''; position: absolute; bottom: 15px; right: 20%; width: 11px; height: 11px; background: #f472b6; border-radius: 50%; box-shadow: 0 0 14px #f472b6; }
    @keyframes spin { from { transform: translate(-50%, -50%) rotate(0deg); } to { transform: translate(-50%, -50%) rotate(360deg); } }
    .loading-text { margin-top: 25px; text-align: center; color: #8ba0d4; font-size: 0.6rem; letter-spacing: 4px; }
    .loading-authors { font-family: 'Space Mono', monospace; font-size: 0.7rem; color: #fff; margin-top: 8px; letter-spacing: 0.5px; }

    .top-bar {
      display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.8rem;
      background: rgba(4,8,24,0.7); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
      border-radius: 1.2rem; border: 1px solid rgba(255,255,255,0.08); z-index: 10; gap: 0.5rem; flex-wrap: wrap;
    }
    .brand { font-size: 0.9rem; font-weight: 900; letter-spacing: -0.5px; background: linear-gradient(180deg, #e0f2fe, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat { text-align: center; }
    .stat-val { font-size: 1rem; font-weight: 700; color: #f0f4ff; }
    .stat-lbl { font-size: 0.45rem; text-transform: uppercase; letter-spacing: 1.5px; color: #6b7fa8; }
    .eff-bar { flex: 1; min-width: 60px; }
    .eff-track { height: 3px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; }
    .eff-fill { height: 100%; background: linear-gradient(90deg, #22d3ee, #c084fc); border-radius: 2px; transition: width 0.5s; }
    .btn {
      padding: 0.5rem 0.8rem; border-radius: 0.8rem; font-size: 0.65rem; font-weight: 600;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); color: #dde4f5;
      cursor: pointer; display: flex; align-items: center; gap: 0.3rem; transition: all 0.3s;
      backdrop-filter: blur(10px); white-space: nowrap;
    }
    .btn:active { transform: scale(0.94); background: rgba(34,211,238,0.15); }
    .btn-hint { background: linear-gradient(135deg, rgba(30,58,138,0.7), rgba(15,23,42,0.8)); border-color: rgba(34,211,238,0.4); }

    .game-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; padding: 0.8rem 0;
      flex: 1; align-content: start;
    }
    .card-wrap {
      aspect-ratio: 3/4.3; cursor: pointer; position: relative;
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
    }
    .card-wrap:active { transform: scale(0.94); }
    .card-inner {
      width: 100%; height: 100%; position: relative; transform-style: preserve-3d;
      transition: transform 0.5s cubic-bezier(0.22,1,0.36,1); border-radius: var(--card-radius);
    }
    .card-inner.flipped { transform: rotateY(180deg); }
    .card-face {
      position: absolute; inset: 0; backface-visibility: hidden; border-radius: var(--card-radius);
      overflow: hidden; box-shadow: 0 15px 30px -10px rgba(0,0,0,0.8);
    }
    .card-back {
      background: radial-gradient(circle at 35% 35%, #1c2a4a, #030818);
      border: 1px solid rgba(255,255,255,0.08);
      display: flex; align-items: center; justify-content: center;
    }
    .card-back::after {
      content: '✦'; font-size: 1.2rem; color: rgba(255,255,255,0.15);
    }
    .card-front {
      transform: rotateY(180deg); background: #010510;
      border: 1px solid rgba(255,255,255,0.15); background-size: cover; background-position: center;
    }
    .card-inner.matched .card-front {
      border-color: rgba(34,211,238,0.6); box-shadow: inset 0 0 30px rgba(34,211,238,0.25);
      animation: matchPulse 1s ease-out;
    }
    @keyframes matchPulse {
      0% { box-shadow: inset 0 0 50px rgba(34,211,238,0.6), 0 0 30px rgba(34,211,238,0.4); }
      100% { box-shadow: inset 0 0 10px rgba(34,211,238,0.1); }
    }
    .planet-sun { background-image: radial-gradient(circle at 38% 38%, #fef08a, #f59e0b 40%, #b45309); }
    .planet-mercury { background-image: radial-gradient(circle at 38% 38%, #d1d5db, #6b7280 50%, #374151); }
    .planet-venus { background-image: radial-gradient(circle at 42% 42%, #fcd34d, #d97706 45%, #78350f); }
    .planet-earth { background-image: radial-gradient(circle at 38% 38%, #60a5fa, #2563eb 45%, #064e3b); }
    .planet-mars { background-image: radial-gradient(circle at 38% 38%, #f87171, #dc2626 45%, #7f1d1d); }
    .planet-jupiter { background-image: radial-gradient(circle at 38% 38%, #ddd6fe, #8b5cf6 45%, #4c1d95); }
    .planet-saturn { background-image: radial-gradient(circle at 38% 38%, #fef3c7, #d97706 40%, #9d174d); }
    .planet-uranus { background-image: radial-gradient(circle at 38% 38%, #a5f3fc, #0891b2 45%, #164e63); }
    .planet-neptune { background-image: radial-gradient(circle at 38% 38%, #93c5fd, #1d4ed8 45%, #1e3a8a); }
    .planet-moon { background-image: radial-gradient(circle at 38% 38%, #f3f4f6, #9ca3af 50%, #4b5563); }
    .planet-galaxy { background-image: radial-gradient(circle at 38% 38%, #c4b5fd, #7c3aed 45%, #2e1065); }
    .planet-nebula { background-image: radial-gradient(circle at 38% 38%, #f9a8d4, #db2777 45%, #831843); }

    .inv-row {
      display: flex; gap: 0.4rem; flex-wrap: wrap; padding: 0.3rem 0; justify-content: center;
    }
    .inv-badge {
      width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.04);
      backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15);
      background-size: cover; background-position: center; cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
      animation: popIn 0.5s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes popIn { 0% { transform: scale(0); } 60% { transform: scale(1.3); } 100% { transform: scale(1); } }
    .inv-badge:active { transform: scale(1.2); }

    .modal {
      position: fixed; inset: 0; background: rgba(1,2,14,0.9); backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px); display: flex; align-items: center; justify-content: center;
      z-index: 100; opacity: 0; pointer-events: none; transition: opacity 0.3s;
    }
    .modal.active { opacity: 1; pointer-events: auto; }
    .modal-card {
      background: rgba(8,16,38,0.9); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px);
      border-radius: 1.5rem; padding: 1.5rem; width: 90%; max-width: 380px;
      border: 1px solid rgba(255,255,255,0.1); color: #fff;
    }
    .stars-display { font-size: 2.5rem; letter-spacing: 0.3rem; animation: starReveal 0.8s ease-out; }
    @keyframes starReveal { 0% { transform: scale(0) rotate(-180deg); opacity: 0; } 100% { transform: scale(1) rotate(0deg); opacity: 1; } }
    .rank-title { font-size: 0.9rem; letter-spacing: 2px; margin: 0.5rem 0; text-transform: uppercase; }
  </style>
</head>
<body>

<div class="stars"></div>

<div id="loading-screen">
  <div class="loader-orbit">
    <div class="loader-sun"></div>
    <div class="orbit orbit1"></div>
    <div class="orbit orbit2"></div>
    <div class="orbit orbit3"></div>
  </div>
  <div class="loading-text" id="loading-status">Загрузка...</div>
  <div class="loading-authors" id="authors-text"></div>
</div>

<div class="top-bar">
  <div class="brand">✦ КОСМОПАРЫ</div>
  <div class="stat"><div class="stat-val" id="moves">0</div><div class="stat-lbl">Ходов</div></div>
  <div class="stat"><div class="stat-val" id="timer">00:00</div><div class="stat-lbl">Время</div></div>
  <div class="eff-bar">
    <div class="stat-lbl" style="margin-bottom:2px;">Эфф. <span id="eff-pct">100%</span></div>
    <div class="eff-track"><div class="eff-fill" id="eff-fill" style="width:100%;"></div></div>
  </div>
  <button class="btn btn-hint" id="hint-btn"><i class="fas fa-sun"></i> <span id="hint-num">2</span></button>
  <button class="btn" onclick="restartGame()"><i class="fas fa-redo"></i></button>
</div>

<div class="inv-row" id="inventory"></div>
<div class="game-grid" id="grid"></div>

<div class="modal" id="info-modal">
  <div class="modal-card">
    <button onclick="closeInfo()" style="float:right;background:none;border:none;color:white;font-size:1.5rem;">&times;</button>
    <h3 id="info-title" style="margin-bottom:0.8rem;"></h3>
    <p id="info-desc" style="color:#bcc8e0; line-height:1.6; font-size:0.85rem;"></p>
  </div>
</div>

<div class="modal" id="win-modal">
  <div class="modal-card" style="text-align:center;">
    <h2 style="font-size:1.2rem; letter-spacing:2px;">ГАЛАКТИКА ОТКРЫТА</h2>
    <div class="stars-display" id="win-stars">★★★</div>
    <div class="rank-title" id="rank-title"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem;margin:1rem 0;text-align:left;">
      <div style="background:rgba(255,255,255,0.04);border-radius:0.8rem;padding:0.6rem;"><span style="font-size:0.5rem;color:#6b7fa8;">ХОДОВ</span><br><span id="fmoves" style="font-size:0.9rem;">0</span></div>
      <div style="background:rgba(255,255,255,0.04);border-radius:0.8rem;padding:0.6rem;"><span style="font-size:0.5rem;color:#6b7fa8;">ВРЕМЯ</span><br><span id="ftime" style="font-size:0.9rem;">00:00</span></div>
      <div style="background:rgba(255,255,255,0.04);border-radius:0.8rem;padding:0.6rem;"><span style="font-size:0.5rem;color:#6b7fa8;">ТОЧНОСТЬ</span><br><span id="facc" style="font-size:0.9rem;">100%</span></div>
      <div style="background:rgba(255,255,255,0.04);border-radius:0.8rem;padding:0.6rem;"><span style="font-size:0.5rem;color:#6b7fa8;">РЕЙТИНГ</span><br><span id="fscore" style="font-size:0.9rem;">0</span></div>
    </div>
    <button class="btn" onclick="restartGame()" style="margin:0 auto; width:100%; justify-content:center;"><i class="fas fa-globe"></i> Новая миссия</button>
  </div>
</div>

<script>
(function() {
  const spaceData = [
    { id: 'sun', name: 'Солнце', desc: 'Центр системы. Температура ядра — 15 млн °C.', imgUrl: '', cls: 'planet-sun' },
    { id: 'mercury', name: 'Меркурий', desc: 'Ближайшая к Солнцу. Перепады от +430°C до -180°C.', imgUrl: '', cls: 'planet-mercury' },
    { id: 'venus', name: 'Венера', desc: 'Самая горячая. Парниковый эффект.', imgUrl: '', cls: 'planet-venus' },
    { id: 'earth', name: 'Земля', desc: 'Наш дом. 71% воды. Жизнь.', imgUrl: '', cls: 'planet-earth' },
    { id: 'mars', name: 'Марс', desc: 'Красная планета. Вулкан Олимп.', imgUrl: '', cls: 'planet-mars' },
    { id: 'jupiter', name: 'Юпитер', desc: 'Крупнейшая. Красное Пятно.', imgUrl: '', cls: 'planet-jupiter' },
    { id: 'saturn', name: 'Сатурн', desc: 'Кольца из льда и пыли.', imgUrl: '', cls: 'planet-saturn' },
    { id: 'uranus', name: 'Уран', desc: 'Вращается на боку.', imgUrl: '', cls: 'planet-uranus' },
    { id: 'neptune', name: 'Нептун', desc: 'Ветер до 2100 км/ч.', imgUrl: '', cls: 'planet-neptune' },
    { id: 'moon', name: 'Луна', desc: 'Спутник Земли.', imgUrl: '', cls: 'planet-moon' },
    { id: 'galaxy', name: 'Млечный Путь', desc: 'Наша галактика.', imgUrl: '', cls: 'planet-galaxy' },
    { id: 'nebula', name: 'Туманность Ориона', desc: 'Звёздные ясли.', imgUrl: '', cls: 'planet-nebula' }
  ];

  const TOTAL = spaceData.length;
  let st = { cards: [], flipped: [], matched: 0, moves: 0, timer: 0, interval: null, hints: 2, locked: false, started: false };

  function fmt(t) { let m=Math.floor(t/60),s=t%60; return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`; }
  function acc(m) { return m===0?100:Math.min(100, Math.round((TOTAL/m)*100)); }
  function scoreCalc(m,t) {
    let s=10000-(Math.max(0,m-TOTAL)*120)-(Math.max(0,t-30)*8);
    if(t<30) s+=(30-t)*15;
    if(m<=TOTAL) s+=(TOTAL-m+1)*200;
    return Math.max(100,Math.min(12000,Math.round(s)));
  }
  function stars(sc) { return sc>=9000?'★★★★★':sc>=7000?'★★★★☆':sc>=5000?'★★★☆☆':sc>=3000?'★★☆☆☆':'★☆☆☆☆'; }
  function rank(sc) { return sc>=9500?'Гранд-мастер':sc>=8000?'Капитан Флота':sc>=6500?'Офицер':sc>=5000?'Навигатор':sc>=3500?'Пилот':sc>=2000?'Кадет':'Турист'; }
  function rankColor(sc) { return sc>=8000?'#fbbf24':sc>=6000?'#c084fc':sc>=4000?'#22d3ee':sc>=2000?'#94a3b8':'#ef4444'; }

  function updEff() {
    if(st.moves===0) { document.getElementById('eff-pct').textContent='100%'; document.getElementById('eff-fill').style.width='100%'; return; }
    let a=acc(st.moves);
    document.getElementById('eff-pct').textContent=a+'%';
    document.getElementById('eff-fill').style.width=a+'%';
    let f=document.getElementById('eff-fill');
    f.style.background=a>=80?'linear-gradient(90deg,#22d3ee,#c084fc)':a>=50?'linear-gradient(90deg,#fbbf24,#f59e0b)':'linear-gradient(90deg,#f87171,#ef4444)';
  }

  function startClk() { if(st.interval) clearInterval(st.interval); st.interval=setInterval(()=>{ st.timer++; document.getElementById('timer').textContent=fmt(st.timer); },1000); }

  function flip(el) {
    if(st.locked||el.classList.contains('flipped')||el.classList.contains('matched')) return;
    if(!st.started){ st.started=true; startClk(); }
    el.classList.add('flipped'); st.flipped.push(el);
    if(st.flipped.length===2){ st.moves++; document.getElementById('moves').textContent=st.moves; updEff(); st.locked=true; check(); }
  }

  function check() {
    let [a,b]=st.flipped;
    if(a.dataset.id===b.dataset.id){
      a.classList.add('matched'); b.classList.add('matched'); st.matched++;
      addInv(a.dataset.id); st.flipped=[]; st.locked=false;
      if(st.matched===TOTAL) win();
    } else { setTimeout(()=>{ a.classList.remove('flipped'); b.classList.remove('flipped'); st.flipped=[]; st.locked=false; },700); }
  }

  function addInv(id) {
    if(document.querySelector(`.inv-badge[data-id="${id}"]`)) return;
    let d=spaceData.find(x=>x.id===id);
    let b=document.createElement('div'); b.className='inv-badge'; b.dataset.id=id;
    if(d.imgUrl&&d.imgUrl.trim()!=='') b.style.backgroundImage=`url(${d.imgUrl})`; else b.classList.add(d.cls);
    b.onclick=()=>showInfo(id);
    document.getElementById('inventory').appendChild(b);
  }

  function showInfo(id) {
    let d=spaceData.find(x=>x.id===id);
    document.getElementById('info-title').textContent=d.name;
    document.getElementById('info-desc').textContent=d.desc;
    document.getElementById('info-modal').classList.add('active');
  }
  window.closeInfo = () => document.getElementById('info-modal').classList.remove('active');

  function win() {
    clearInterval(st.interval);
    let sc=scoreCalc(st.moves,st.timer), a=acc(st.moves);
    document.getElementById('fmoves').textContent=st.moves;
    document.getElementById('ftime').textContent=fmt(st.timer);
    document.getElementById('facc').textContent=a+'%';
    document.getElementById('fscore').textContent=sc;
    document.getElementById('win-stars').textContent=stars(sc);
    let r=document.getElementById('rank-title'); r.textContent=rank(sc); r.style.color=rankColor(sc);
    document.getElementById('win-modal').classList.add('active');
  }

  function restartGame() {
    clearInterval(st.interval);
    st={ cards:[], flipped:[], matched:0, moves:0, timer:0, interval:null, hints:2, locked:false, started:false };
    document.getElementById('moves').textContent='0'; document.getElementById('timer').textContent='00:00';
    document.getElementById('hint-num').textContent='2'; document.getElementById('eff-pct').textContent='100%';
    document.getElementById('eff-fill').style.width='100%'; document.getElementById('inventory').innerHTML='';
    document.getElementById('win-modal').classList.remove('active'); updEff(); build();
  }

  function build() {
    let grid=document.getElementById('grid'); grid.innerHTML='';
    let deck=[...spaceData,...spaceData].sort(()=>Math.random()-0.5);
    deck.forEach(item=>{
      let w=document.createElement('div'); w.className='card-wrap';
      let inner=document.createElement('div'); inner.className='card-inner'; inner.dataset.id=item.id;
      let fb=item.imgUrl&&item.imgUrl.trim()!==''?`background-image:url('${item.imgUrl}');background-size:cover;`:'';
      inner.innerHTML=`<div class="card-face card-front ${(!item.imgUrl||item.imgUrl.trim()==='')?item.cls:''}" style="${fb}"></div><div class="card-face card-back"></div>`;
      w.appendChild(inner); w.addEventListener('click',()=>flip(inner));
      grid.appendChild(w); st.cards.push(inner);
    });
  }

  document.getElementById('hint-btn').addEventListener('click',()=>{
    if(st.locked||st.hints<=0) return;
    if(!st.started){ st.started=true; startClk(); }
    st.hints--; document.getElementById('hint-num').textContent=st.hints;
    st.locked=true;
    let hidden=st.cards.filter(c=>!c.classList.contains('matched')&&!c.classList.contains('flipped'));
    hidden.forEach(c=>c.classList.add('flipped'));
    setTimeout(()=>{ hidden.forEach(c=>c.classList.remove('flipped')); st.locked=false; },1200);
  });

  window.restartGame = restartGame;
  build();

  window.addEventListener('load',()=>{
    let txt="Авторы: Голосов Д.А. | Баринова С.В. | Климов В.";
    let el=document.getElementById('authors-text'); let i=0;
    function type(){ if(i<txt.length){ el.textContent+=txt.charAt(i); i++; setTimeout(type,30); } else { document.getElementById('loading-status').textContent='Готово'; setTimeout(()=>{ document.getElementById('loading-screen').style.opacity='0'; setTimeout(()=>document.getElementById('loading-screen').style.display='none',800); },600); } }
    setTimeout(type,400);
  });

  document.getElementById('info-modal').addEventListener('click',function(e){ if(e.target===this) closeInfo(); });
  document.getElementById('win-modal').addEventListener('click',function(e){ if(e.target===this) this.classList.remove('active'); });
})();
</script>
