<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Cosmos OS: Memory of Worlds</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Orbitron:wght@400;600;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg-void: #010314;
      --text-bright: #F2F6FF;
      --text-soft: #A0B4E0;
      --accent-blue: #38BDF8;
      --accent-purple: #C084FC;
      --accent-teal: #2DD4BF;
      --accent-pink: #F472B6;
      --glass-bg: rgba(8, 14, 35, 0.55);
      --glass-border: rgba(255, 255, 255, 0.08);
      --card-radius: 1.5rem;
      --card-radius-mobile: 1.2rem;
      --glow-blue: 0 0 35px rgba(56, 189, 248, 0.45);
      --glow-purple: 0 0 40px rgba(192, 132, 252, 0.4);
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: radial-gradient(ellipse at 35% 25%, #0c0a2e 0%, #010314 70%);
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      margin: 0;
      position: relative;
      overflow-x: hidden;
      overflow-y: auto;
    }

    /* МНОГОСЛОЙНЫЙ АНИМИРОВАННЫЙ КОСМИЧЕСКИЙ ФОН */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: 
        radial-gradient(1.5px 1.5px at 10% 25%, rgba(255,255,255,0.95), transparent),
        radial-gradient(2px 2px at 25% 60%, rgba(180,210,255,0.8), transparent),
        radial-gradient(1px 1px at 45% 15%, #ffffff, transparent),
        radial-gradient(2px 2px at 75% 70%, rgba(200,230,255,0.75), transparent),
        radial-gradient(1.5px 1.5px at 90% 35%, rgba(255,255,255,0.9), transparent),
        radial-gradient(2px 2px at 55% 85%, rgba(160,200,255,0.7), transparent),
        radial-gradient(1px 1px at 30% 45%, #e2e8f0, transparent),
        radial-gradient(2px 2px at 68% 20%, rgba(220,240,255,0.8), transparent),
        radial-gradient(1.5px 1.5px at 82% 52%, #ffffff, transparent),
        radial-gradient(3px 3px at 15% 75%, rgba(255,255,255,0.6), transparent),
        radial-gradient(1px 1px at 95% 10%, rgba(200,220,255,0.9), transparent);
      background-size: 220px 220px;
      opacity: 0.65;
      animation: starfieldDrift 20s infinite alternate ease-in-out;
      pointer-events: none;
      z-index: 0;
    }

    @keyframes starfieldDrift {
      0% { opacity: 0.5; transform: scale(1) rotate(0deg); }
      50% { opacity: 0.8; transform: scale(1.03) rotate(0.5deg); }
      100% { opacity: 0.65; transform: scale(1) rotate(0deg); }
    }

    /* ПАДАЮЩИЕ ЗВЁЗДЫ */
    .shooting-stars {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
    }

    .shooting-star {
      position: absolute;
      width: 3px;
      height: 3px;
      background: white;
      border-radius: 50%;
      box-shadow: 0 0 6px 2px rgba(255,255,255,0.8);
      animation: shoot 4s linear infinite;
      opacity: 0;
    }

    .shooting-star::after {
      content: '';
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 60px;
      height: 1.5px;
      background: linear-gradient(90deg, rgba(255,255,255,0.8), transparent);
    }

    .shooting-star:nth-child(1) { top: 15%; left: 80%; animation-delay: 0s; }
    .shooting-star:nth-child(2) { top: 25%; left: 60%; animation-delay: 2.5s; }
    .shooting-star:nth-child(3) { top: 10%; left: 70%; animation-delay: 5s; }
    .shooting-star:nth-child(4) { top: 35%; left: 85%; animation-delay: 1.5s; }
    .shooting-star:nth-child(5) { top: 20%; left: 50%; animation-delay: 3.8s; }

    @keyframes shoot {
      0% { opacity: 0; transform: translate(0, 0) rotate(-35deg); }
      5% { opacity: 1; }
      15% { opacity: 0; transform: translate(-300px, 200px) rotate(-35deg); }
      100% { opacity: 0; transform: translate(-300px, 200px) rotate(-35deg); }
    }

    /* ТУМАННОСТИ */
    .nebula-aurora {
      position: fixed;
      top: -25%;
      right: -15%;
      width: 80vw;
      height: 80vw;
      background: radial-gradient(circle at 65% 30%, rgba(192, 132, 252, 0.25), transparent 70%);
      filter: blur(100px);
      z-index: 0;
      pointer-events: none;
      animation: nebulaBreath 12s infinite alternate;
    }

    .nebula-deep {
      position: fixed;
      bottom: -20%;
      left: -12%;
      width: 70vw;
      height: 70vw;
      background: radial-gradient(circle at 30% 75%, rgba(45, 212, 191, 0.2), transparent 70%);
      filter: blur(100px);
      z-index: 0;
      pointer-events: none;
      animation: nebulaBreath 15s infinite alternate-reverse;
    }

    .nebula-core {
      position: fixed;
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 50vw;
      height: 50vw;
      background: radial-gradient(circle at 50% 50%, rgba(56, 189, 248, 0.08), transparent 70%);
      filter: blur(100px);
      z-index: 0;
      pointer-events: none;
    }

    @keyframes nebulaBreath {
      0% { opacity: 0.6; transform: scale(1); }
      100% { opacity: 1; transform: scale(1.1); }
    }

    /* ЧАСТИЦЫ */
    .particles {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 2;
    }

    .particle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: rgba(255,255,255,0.4);
      border-radius: 50%;
      animation: floatUp 8s linear infinite;
    }

    @keyframes floatUp {
      0% { transform: translateY(100vh) scale(0); opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { transform: translateY(-10vh) scale(1.5); opacity: 0; }
    }

    /* ЗАГРУЗОЧНЫЙ ЭКРАН */
    #loading-screen {
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse at center, #0a0a2e 0%, #000000 100%);
      z-index: 9999;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: opacity 1s ease-out, visibility 1s;
    }

    .loader-orbit-system {
      position: relative;
      width: 300px;
      height: 300px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .loader-sun {
      width: 60px;
      height: 60px;
      background: radial-gradient(circle, #ffcc00, #ff8800);
      border-radius: 50%;
      box-shadow: 0 0 60px #ffaa00, 0 0 120px rgba(255,170,0,0.4);
      z-index: 2;
      animation: sunGlow 2s ease-in-out infinite;
    }

    @keyframes sunGlow {
      0%, 100% { box-shadow: 0 0 60px #ffaa00, 0 0 120px rgba(255,170,0,0.4); }
      50% { box-shadow: 0 0 80px #ffcc00, 0 0 160px rgba(255,170,0,0.6); }
    }

    .loader-planet {
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.08);
      animation: orbit linear infinite;
    }

    .p1 { width: 110px; height: 110px; animation-duration: 3s; }
    .p1::after { content: ''; position: absolute; top: 10px; left: 50%; width: 10px; height: 10px; background: #0A84FF; border-radius: 50%; box-shadow: 0 0 15px #0A84FF; }
    
    .p2 { width: 190px; height: 190px; animation-duration: 5s; }
    .p2::after { content: ''; position: absolute; top: 20px; left: 10%; width: 14px; height: 14px; background: #BF5AF2; border-radius: 50%; box-shadow: 0 0 18px #BF5AF2; }

    .p3 { width: 270px; height: 270px; animation-duration: 8s; }
    .p3::after { content: ''; position: absolute; bottom: 30px; right: 15%; width: 18px; height: 18px; background: #ff4d4d; border-radius: 50%; box-shadow: 0 0 20px #ff4d4d; }

    @keyframes orbit {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    #loading-screen.align-planets .loader-planet {
      animation: none !important;
      transform: rotate(0deg);
      transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .loading-text-container {
      margin-top: 40px;
      text-align: center;
      min-height: 60px;
    }

    .loading-status {
      font-family: 'Orbitron', sans-serif;
      font-weight: 400;
      letter-spacing: 5px;
      color: #A0B4E0;
      font-size: 0.7rem;
      margin-bottom: 12px;
      text-transform: uppercase;
    }

    .loading-authors {
      font-size: 0.9rem;
      color: #fff;
      letter-spacing: 1px;
    }

    .cursor {
      display: inline-block;
      width: 8px;
      height: 15px;
      background: #38BDF8;
      margin-left: 5px;
      vertical-align: middle;
      animation: blink 1s step-end infinite;
    }

    @keyframes blink { 50% { opacity: 0; } }

    /* ОСНОВНОЙ КОНТЕЙНЕР */
    .app-container {
      display: flex;
      width: 100%;
      max-width: 1550px;
      gap: 1.5rem;
      position: relative;
      z-index: 10;
      align-items: flex-start;
    }

    /* САЙДБАР */
    .sidebar {
      width: 280px;
      flex-shrink: 0;
      background: rgba(6, 10, 30, 0.6);
      backdrop-filter: blur(45px);
      -webkit-backdrop-filter: blur(45px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 2.5rem;
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
      box-shadow: 0 40px 60px -20px rgba(0,0,0,0.8), inset 0 0 40px rgba(56, 189, 248, 0.06);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .sidebar::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle at 30% 20%, rgba(192,132,252,0.06), transparent 60%);
      pointer-events: none;
    }

    .brand {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.8rem;
      font-weight: 900;
      letter-spacing: -0.5px;
      background: linear-gradient(180deg, #E0F2FE 0%, #7DD3FC 80%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 0 20px rgba(56,189,248,0.5));
      position: relative;
      z-index: 1;
    }

    .stats-panel {
      display: flex;
      gap: 0.7rem;
      position: relative;
      z-index: 1;
    }

    .stat-box {
      background: rgba(255,255,255,0.03);
      border-radius: 1.2rem;
      padding: 0.9rem 0.5rem;
      flex: 1;
      text-align: center;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.06);
      transition: all 0.3s;
    }

    .stat-box:hover {
      background: rgba(255,255,255,0.06);
      border-color: rgba(56,189,248,0.3);
      box-shadow: 0 0 20px rgba(56,189,248,0.15);
    }

    .stat-num {
      font-size: 1.6rem;
      font-weight: 700;
      color: #F0F4FF;
      font-family: 'Orbitron', sans-serif;
    }

    .actions {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      position: relative;
      z-index: 1;
    }

    .btn {
      padding: 0.9rem;
      border-radius: 1.2rem;
      font-weight: 600;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      color: #E2E8F0;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      backdrop-filter: blur(12px);
      font-size: 0.85rem;
      position: relative;
      overflow: hidden;
    }

    .btn::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: rgba(255,255,255,0.1);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .btn:active::after {
      width: 300px;
      height: 300px;
    }

    .btn:hover {
      background: rgba(56,189,248,0.1);
      border-color: rgba(56,189,248,0.5);
      box-shadow: 0 0 28px rgba(56,189,248,0.3);
      transform: translateY(-2px);
    }

    .btn-hint {
      background: linear-gradient(135deg, rgba(30, 64, 175, 0.5), rgba(15, 23, 42, 0.7));
      border-color: rgba(56,189,248,0.4);
    }

    .inventory-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 0.5rem;
      position: relative;
      z-index: 1;
    }

    .inv-badge {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255,255,255,0.15);
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 0.75rem;
      background-size: cover;
      background-position: center;
      position: relative;
    }

    .inv-badge:hover {
      transform: scale(1.25);
      border-color: #C084FC;
      box-shadow: 0 0 30px rgba(192,132,252,0.6);
      z-index: 5;
    }

    .inv-badge.matched-anim {
      animation: badgePop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes badgePop {
      0% { transform: scale(0); }
      60% { transform: scale(1.3); }
      100% { transform: scale(1); }
    }

    /* ИГРОВАЯ СЕТКА */
    .game-grid {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1rem;
      perspective: 2000px;
    }

    .card-wrapper {
      aspect-ratio: 3 / 4.2;
      cursor: pointer;
      transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      position: relative;
    }

    .card-wrapper:hover {
      transform: translateY(-8px);
      z-index: 5;
    }

    .card-wrapper::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: var(--card-radius);
      background: transparent;
      transition: all 0.4s;
      z-index: -1;
    }

    .card-wrapper:hover::after {
      background: linear-gradient(135deg, rgba(56,189,248,0.3), rgba(192,132,252,0.3));
      filter: blur(15px);
      inset: -6px;
      border-radius: calc(var(--card-radius) + 4px);
    }

    .card-inner {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      border-radius: var(--card-radius);
    }

    .card-inner.flipped {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      border-radius: var(--card-radius);
      overflow: hidden;
      box-shadow: 0 25px 40px -15px rgba(0,0,0,0.9);
    }

    .card-back {
      background: radial-gradient(circle at 30% 35%, #1a2040, #020617);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255,255,255,0.08);
      background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none"><path d="M50 15 L58 42 L85 50 L58 58 L50 85 L42 58 L15 50 L42 42 Z" fill="white" fill-opacity="0.15"/><circle cx="50" cy="50" r="18" stroke="white" stroke-opacity="0.2" stroke-width="1"/><circle cx="50" cy="50" r="28" stroke="white" stroke-opacity="0.08" stroke-width="0.5"/></svg>');
      background-size: 55%;
      background-repeat: no-repeat;
      background-position: center;
      transition: all 0.3s;
    }

    .card-wrapper:hover .card-back {
      border-color: rgba(255,255,255,0.2);
    }

    .card-front {
      transform: rotateY(180deg);
      background: #030712;
      border: 1px solid rgba(255,255,255,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      background-size: cover;
      background-position: center;
    }

    .card-inner.matched .card-front {
      border-color: rgba(45,212,191,0.5);
      box-shadow: inset 0 0 40px rgba(45,212,191,0.15);
    }

    /* ПЛАНЕТАРНЫЕ ГРАДИЕНТЫ */
    .planet-sun { background-image: radial-gradient(circle at 35% 35%, #FDE047, #B45309); }
    .planet-mercury { background-image: radial-gradient(circle at 35% 35%, #D1D5DB, #4B5563); }
    .planet-venus { background-image: radial-gradient(circle at 40% 40%, #FBBF24, #92400E); }
    .planet-earth { background-image: radial-gradient(circle at 35% 35%, #60A5FA, #064E3B); }
    .planet-mars { background-image: radial-gradient(circle at 35% 35%, #F87171, #7F1D1D); }
    .planet-jupiter { background-image: radial-gradient(circle at 35% 35%, #C4B5FD, #5B21B6); }
    .planet-saturn { background-image: radial-gradient(circle at 35% 35%, #FDE68A, #9D174D); }
    .planet-uranus { background-image: radial-gradient(circle at 35% 35%, #67E8F9, #155E75); }
    .planet-neptune { background-image: radial-gradient(circle at 35% 35%, #60A5FA, #1E3A8A); }
    .planet-moon { background-image: radial-gradient(circle at 35% 35%, #F3F4F6, #6B7280); }
    .planet-galaxy { background-image: radial-gradient(circle at 35% 35%, #A78BFA, #4C1D95); }
    .planet-nebula { background-image: radial-gradient(circle at 35% 35%, #F472B6, #831843); }

    /* МОДАЛЬНЫЕ ОКНА */
    .info-modal {
      position: fixed;
      inset: 0;
      background: rgba(2,0,16,0.85);
      backdrop-filter: blur(40px);
      -webkit-backdrop-filter: blur(40px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s;
    }

    .info-modal.active {
      opacity: 1;
      pointer-events: auto;
    }

    .info-card {
      background: rgba(10, 18, 40, 0.9);
      backdrop-filter: blur(50px);
      -webkit-backdrop-filter: blur(50px);
      border-radius: 2rem;
      padding: 2rem;
      max-width: 500px;
      width: 90%;
      border: 1px solid rgba(255,255,255,0.15);
      color: white;
      box-shadow: 0 30px 60px rgba(0,0,0,0.7);
      transform: scale(0.9);
      transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .info-modal.active .info-card {
      transform: scale(1);
    }

    .win-overlay {
      position: fixed;
      inset: 0;
      background: rgba(1, 3, 20, 0.92);
      backdrop-filter: blur(50px);
      -webkit-backdrop-filter: blur(50px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s, visibility 0.4s;
    }

    .win-overlay.visible {
      opacity: 1;
      visibility: visible;
    }

    .win-content {
      text-align: center;
      color: white;
      transform: translateY(30px);
      transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .win-overlay.visible .win-content {
      transform: translateY(0);
    }

    /* АДАПТИВНОСТЬ */
    @media (max-width: 1200px) {
      .game-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 0.8rem;
      }
      .sidebar {
        width: 240px;
        padding: 1.5rem 1.2rem;
        border-radius: 2rem;
      }
      .brand {
        font-size: 1.5rem;
      }
    }

    @media (max-width: 768px) {
      body {
        padding: 0.5rem;
        align-items: flex-start;
        overflow-y: auto;
      }

      .app-container {
        flex-direction: column;
        gap: 1rem;
        width: 100%;
      }

      .sidebar {
        width: 100%;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.8rem;
        padding: 1rem 1.2rem;
        border-radius: 1.5rem;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0.5rem;
        z-index: 50;
      }

      .brand {
        font-size: 1.3rem;
        order: 1;
      }

      .stats-panel {
        order: 2;
        gap: 0.5rem;
      }

      .stat-box {
        padding: 0.5rem 0.6rem;
        border-radius: 0.8rem;
      }

      .stat-num {
        font-size: 1.1rem;
      }

      .actions {
        flex-direction: row;
        order: 3;
        width: 100%;
        gap: 0.5rem;
      }

      .btn {
        flex: 1;
        padding: 0.7rem;
        font-size: 0.78rem;
        border-radius: 1rem;
      }

      .inventory-grid {
        order: 4;
        width: 100%;
        justify-content: flex-start;
        gap: 0.4rem;
        margin-top: 0;
      }

      .inv-badge {
        width: 36px;
        height: 36px;
        font-size: 0.65rem;
      }

      .game-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 0.6rem;
      }

      .card-wrapper {
        aspect-ratio: 3 / 4.5;
      }

      :root {
        --card-radius: 1rem;
      }

      .card-wrapper:hover {
        transform: translateY(-4px);
      }

      .card-wrapper:hover::after {
        inset: -3px;
        border-radius: calc(var(--card-radius) + 3px);
      }

      .shooting-star {
        display: none;
      }
    }

    @media (max-width: 480px) {
      .game-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 0.5rem;
      }

      .sidebar {
        padding: 0.8rem 1rem;
        gap: 0.6rem;
        border-radius: 1.2rem;
        top: 0.3rem;
      }

      .brand {
        font-size: 1.1rem;
      }

      .stat-box {
        padding: 0.4rem 0.5rem;
      }

      .stat-num {
        font-size: 1rem;
      }

      .btn {
        padding: 0.6rem;
        font-size: 0.7rem;
        border-radius: 0.8rem;
      }

      .inv-badge {
        width: 30px;
        height: 30px;
      }

      .info-card {
        padding: 1.5rem;
        border-radius: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <!-- ФОНОВЫЕ ЭФФЕКТЫ -->
  <div class="nebula-aurora"></div>
  <div class="nebula-deep"></div>
  <div class="nebula-core"></div>

  <!-- ПАДАЮЩИЕ ЗВЁЗДЫ -->
  <div class="shooting-stars">
    <div class="shooting-star"></div>
    <div class="shooting-star"></div>
    <div class="shooting-star"></div>
    <div class="shooting-star"></div>
    <div class="shooting-star"></div>
  </div>

  <!-- ПАРЯЩИЕ ЧАСТИЦЫ -->
  <div class="particles" id="particles"></div>

  <!-- ЗАГРУЗОЧНЫЙ ЭКРАН -->
  <div id="loading-screen">
    <div class="loader-orbit-system">
      <div class="loader-sun"></div>
      <div class="loader-planet p1"></div>
      <div class="loader-planet p2"></div>
      <div class="loader-planet p3"></div>
    </div>
    <div class="loading-text-container">
      <div class="loading-status" id="loading-status">System initializing...</div>
      <div class="loading-authors">
        <span id="authors-loader-text"></span><span class="cursor"></span>
      </div>
    </div>
  </div>

  <!-- ОСНОВНОЙ ИНТЕРФЕЙС -->
  <div class="app-container">
    <aside class="sidebar">
      <div class="brand">✦ COSMOS</div>
      <div class="stats-panel">
        <div class="stat-box">
          <span class="stat-num" id="moves">0</span>
          <br><small style="color:#A0B4E0; font-size:0.7rem;">ХОДОВ</small>
        </div>
        <div class="stat-box">
          <span class="stat-num" id="timer">00:00</span>
          <br><small style="color:#A0B4E0; font-size:0.7rem;">ВРЕМЯ</small>
        </div>
      </div>
      <div class="actions">
        <button class="btn btn-hint" id="hint-btn">
          <i class="fas fa-sun"></i> Подсказка (<span id="hints-count">2</span>)
        </button>
        <button class="btn" onclick="restartGame()">
          <i class="fas fa-rocket"></i> Миссия
        </button>
      </div>
      <div>
        <small style="color:#A0B4E0; letter-spacing:1px; font-size:0.7rem;">СОБРАННЫЕ МИРЫ</small>
        <div class="inventory-grid" id="inventory"></div>
      </div>
    </aside>

    <main class="game-grid" id="grid"></main>
  </div>

  <!-- ИНФОРМАЦИОННОЕ ОКНО -->
  <div class="info-modal" id="info-modal">
    <div class="info-card">
      <button onclick="closeInfo()" style="float:right;background:none;border:none;color:white;font-size:1.8rem;cursor:pointer;line-height:1;">&times;</button>
      <h3 id="info-title" style="font-family:'Orbitron'; margin-bottom:1rem;"></h3>
      <p id="info-desc" style="color:#cbd5e1; line-height:1.6;"></p>
    </div>
  </div>

  <!-- ЭКРАН ПОБЕДЫ -->
  <div class="win-overlay" id="win-screen">
    <div class="win-content">
      <h2 style="font-family:'Orbitron'; font-size:2rem; margin-bottom:1rem;">СИСТЕМА ИЗУЧЕНА</h2>
      <p id="win-stars" style="font-size:3.5rem; margin-bottom:1rem;">★★★</p>
      <p style="color:#A0B4E0; margin-bottom:0.5rem;">Ходов: <span id="final-moves">0</span></p>
      <p style="color:#A0B4E0; margin-bottom:2rem;">Время: <span id="final-time">00:00</span></p>
      <button class="btn" onclick="restartGame()" style="margin:0 auto; min-width:200px;">
        <i class="fas fa-globe"></i> Продолжить
      </button>
    </div>
  </div>

  <script>
    (function() {
      // ⚠️ МЕСТА ДЛЯ ВСТАВКИ URL ССЫЛОК НА КАРТИНКИ ПЛАНЕТ
      const spaceData = [
        { id: 'sun', name: 'Солнце', type: 'Звезда', desc: 'Центр системы. Температура ядра достигает 15 млн °C. Содержит 99.8% всей массы.', imgUrl: '', planetClass: 'planet-sun' },
        { id: 'mercury', name: 'Меркурий', type: 'Планета', desc: 'Ближайшая к Солнцу планета. Перепады температур от +430°C до -180°C.', imgUrl: '', planetClass: 'planet-mercury' },
        { id: 'venus', name: 'Венера', type: 'Планета', desc: 'Самая горячая планета. Атмосфера из углекислого газа создаёт парниковый эффект.', imgUrl: '', planetClass: 'planet-venus' },
        { id: 'earth', name: 'Земля', type: 'Планета', desc: 'Наш дом. 71% поверхности покрыто водой. Единственная известная планета с жизнью.', imgUrl: '', planetClass: 'planet-earth' },
        { id: 'mars', name: 'Марс', type: 'Планета', desc: 'Красная планета. Здесь находится Олимп — высочайший вулкан в Солнечной системе.', imgUrl: '', planetClass: 'planet-mars' },
        { id: 'jupiter', name: 'Юпитер', type: 'Газовый гигант', desc: 'Самая большая планета. Большое Красное Пятно — шторм размером с Землю.', imgUrl: '', planetClass: 'planet-jupiter' },
        { id: 'saturn', name: 'Сатурн', type: 'Газовый гигант', desc: 'Великолепная система колец из льда и пыли. Плотность меньше плотности воды.', imgUrl: '', planetClass: 'planet-saturn' },
        { id: 'uranus', name: 'Уран', type: 'Ледяной гигант', desc: 'Вращается «лёжа на боку». Ось наклонена почти на 98 градусов.', imgUrl: '', planetClass: 'planet-uranus' },
        { id: 'neptune', name: 'Нептун', type: 'Ледяной гигант', desc: 'Самая ветреная планета. Скорость ветра достигает 2100 км/ч.', imgUrl: '', planetClass: 'planet-neptune' },
        { id: 'moon', name: 'Луна', type: 'Спутник', desc: 'Единственный спутник Земли. Вызывает приливы и всегда повёрнута одной стороной.', imgUrl: 'data:image/jpeg;base64,', planetClass: 'planet-moon' },
        { id: 'galaxy', name: 'Млечный Путь', type: 'Галактика', desc: 'Наша галактика. Содержит от 100 до 400 миллиардов звёзд.', imgUrl: 'data:image/jpeg;base64,', planetClass: 'planet-galaxy' },
        { id: 'nebula', name: 'Туманность Ориона', type: 'Туманность', desc: 'Звёздные ясли. Здесь прямо сейчас рождаются новые звёзды.', imgUrl: '', planetClass: 'planet-nebula' }
      ];

      let state = {
        cards: [], flipped: [], matched: 0, moves: 0, timer: 0,
        interval: null, hintsLeft: 2, locked: false, gameStarted: false
      };

      // Генерация частиц
      function createParticles() {
        const container = document.getElementById('particles');
        if (!container) return;
        container.innerHTML = '';
        for (let i = 0; i < 25; i++) {
          const particle = document.createElement('div');
          particle.className = 'particle';
          particle.style.left = Math.random() * 100 + '%';
          particle.style.animationDelay = Math.random() * 8 + 's';
          particle.style.animationDuration = (Math.random() * 6 + 6) + 's';
          particle.style.width = (Math.random() * 4 + 2) + 'px';
          particle.style.height = particle.style.width;
          particle.style.opacity = Math.random() * 0.5 + 0.2;
          container.appendChild(particle);
        }
      }

      function formatTime(sec) {
        const m = Math.floor(sec / 60);
        const s = sec % 60;
        return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
      }

      function startTimer() {
        if (state.interval) clearInterval(state.interval);
        state.interval = setInterval(() => {
          state.timer++;
          document.getElementById('timer').textContent = formatTime(state.timer);
        }, 1000);
      }

      function flipCard(cardEl) {
        if (state.locked || cardEl.classList.contains('flipped') || cardEl.classList.contains('matched')) return;
        if (!state.gameStarted) { state.gameStarted = true; startTimer(); }
        cardEl.classList.add('flipped');
        state.flipped.push(cardEl);
        if (state.flipped.length === 2) {
          state.moves++;
          document.getElementById('moves').textContent = state.moves;
          state.locked = true;
          checkMatch();
        }
      }

      function checkMatch() {
        const [c1, c2] = state.flipped;
        if (c1.dataset.id === c2.dataset.id) {
          c1.classList.add('matched'); 
          c2.classList.add('matched');
          state.matched++;
          addToInventory(c1.dataset.id);
          state.flipped = []; 
          state.locked = false;
          if (state.matched === spaceData.length) endGame();
        } else {
          setTimeout(() => {
            c1.classList.remove('flipped'); 
            c2.classList.remove('flipped');
            state.flipped = []; 
            state.locked = false;
          }, 900);
        }
      }

      function addToInventory(id) {
        if (document.querySelector(`.inv-badge[data-id="${id}"]`)) return;
        const data = spaceData.find(d => d.id === id);
        const badge = document.createElement('div');
        badge.className = 'inv-badge matched-anim';
        badge.dataset.id = id;
        if (data.imgUrl && data.imgUrl.trim() !== '') {
          badge.style.backgroundImage = `url(${data.imgUrl})`;
        } else {
          badge.classList.add(data.planetClass);
        }
        badge.onclick = () => showInfo(id);
        document.getElementById('inventory').appendChild(badge);
        setTimeout(() => badge.classList.remove('matched-anim'), 500);
      }

      function showInfo(id) {
        const d = spaceData.find(x => x.id === id);
        document.getElementById('info-title').textContent = d.name;
        document.getElementById('info-desc').textContent = d.desc;
        document.getElementById('info-modal').classList.add('active');
      }

      window.closeInfo = () => document.getElementById('info-modal').classList.remove('active');

      function endGame() {
        clearInterval(state.interval);
        document.getElementById('final-moves').textContent = state.moves;
        document.getElementById('final-time').textContent = formatTime(state.timer);
        document.getElementById('win-screen').classList.add('visible');
      }

      function restartGame() {
        clearInterval(state.interval);
        state = { cards: [], flipped: [], matched: 0, moves: 0, timer: 0, interval: null, hintsLeft: 2, locked: false, gameStarted: false };
        document.getElementById('moves').textContent = '0';
        document.getElementById('timer').textContent = '00:00';
        document.getElementById('hints-count').textContent = '2';
        document.getElementById('win-screen').classList.remove('visible');
        document.getElementById('inventory').innerHTML = '';
        initBoard();
      }

      function initBoard() {
        const grid = document.getElementById('grid');
        grid.innerHTML = '';
        const pairs = [...spaceData, ...spaceData].sort(() => Math.random() - 0.5);
        pairs.forEach((item, index) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'card-wrapper';
          wrapper.style.animationDelay = `${index * 0.05}s`;
          
          const inner = document.createElement('div');
          inner.className = 'card-inner';
          inner.dataset.id = item.id;
          
          let frontStyle = '';
          if (item.imgUrl && item.imgUrl.trim() !== '') {
            frontStyle = `background-image: url('${item.imgUrl}'); background-size: cover;`;
          }
          
          inner.innerHTML = `
            <div class="card-face card-front ${(!item.imgUrl || item.imgUrl.trim() === '') ? item.planetClass : ''}" style="${frontStyle}"></div>
            <div class="card-face card-back"></div>
          `;
          wrapper.appendChild(inner);
          wrapper.addEventListener('click', () => flipCard(inner));
          grid.appendChild(wrapper);
          state.cards.push(inner);
        });
      }

      document.getElementById('hint-btn').addEventListener('click', () => {
        if (state.locked || state.hintsLeft <= 0) return;
        if (!state.gameStarted) { state.gameStarted = true; startTimer(); }
        state.hintsLeft--;
        document.getElementById('hints-count').textContent = state.hintsLeft;
        if (state.hintsLeft === 0) document.getElementById('hint-btn').disabled = true;
        state.locked = true;
        const hidden = state.cards.filter(c => !c.classList.contains('matched') && !c.classList.contains('flipped'));
        hidden.forEach(c => c.classList.add('flipped'));
        setTimeout(() => {
          hidden.forEach(c => c.classList.remove('flipped'));
          state.locked = false;
        }, 1400);
      });

      window.restartGame = restartGame;
      createParticles();
      initBoard();

      // ЗАГРУЗКА
      window.addEventListener('load', () => {
        const authorsText = "Авторы: Голосов Даниил Алексеевич | Баринова София Владимировна";
        const container = document.getElementById('authors-loader-text');
        let i = 0;
        function typeWriter() {
          if (i < authorsText.length) {
            container.textContent += authorsText.charAt(i);
            i++;
            setTimeout(typeWriter, 40);
          } else {
            document.getElementById('loading-status').textContent = "Authorization successful. Welcome.";
            setTimeout(() => {
              document.getElementById('loading-screen').classList.add('align-planets');
              setTimeout(() => {
                document.getElementById('loading-screen').style.opacity = '0';
                setTimeout(() => { 
                  document.getElementById('loading-screen').style.display = 'none'; 
                }, 1000);
              }, 1500);
            }, 800);
          }
        }
        setTimeout(typeWriter, 800);
      });

      // Закрытие модального окна по клику вне карточки
      document.getElementById('info-modal').addEventListener('click', function(e) {
        if (e.target === this) closeInfo();
      });
    })();
  </script>
</body>
</html>
