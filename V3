<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>✦ КОСМИЧЕСКИЕ ПАРЫ ✦</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    :root{--cyan:#22d3ee;--purple:#c084fc;--pink:#f472b6;--gold:#fbbf24;--bg:#020010;--cr:1rem}
    body{font-family:'Orbitron',sans-serif;background:var(--bg);min-height:100dvh;display:flex;flex-direction:column;padding:.5rem;overflow-x:hidden;user-select:none;-webkit-tap-highlight-color:transparent}
    body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(ellipse at 50% 40%,rgba(34,211,238,.08),transparent 60%),radial-gradient(ellipse at 80% 20%,rgba(192,132,252,.06),transparent 50%);animation:bgP 8s infinite alternate}
    @keyframes bgP{0%{opacity:.6}100%{opacity:1}}
    .stars{position:fixed;inset:0;z-index:0;pointer-events:none;background-image:radial-gradient(1px 1px at 10% 20%,#fff,transparent),radial-gradient(1px 1px at 30% 60%,#fff,transparent),radial-gradient(1.5px 1.5px at 50% 30%,#fff,transparent),radial-gradient(1px 1px at 70% 70%,#fff,transparent),radial-gradient(1.5px 1.5px at 85% 40%,#fff,transparent),radial-gradient(1px 1px at 20% 85%,#fff,transparent),radial-gradient(1px 1px at 60% 15%,#fff,transparent),radial-gradient(1.5px 1.5px at 40% 55%,#fff,transparent);background-size:200px 200px;opacity:.5;animation:tw 4s infinite alternate}
    @keyframes tw{0%{opacity:.3}100%{opacity:.7}}
    #loading-screen{position:fixed;inset:0;background:#000;z-index:999;display:flex;flex-direction:column;justify-content:center;align-items:center;transition:opacity .8s,visibility .8s}
    .loader-orbit{width:180px;height:180px;position:relative}
    .loader-sun{width:45px;height:45px;background:radial-gradient(circle,#ffdd55,#ff7700);border-radius:50%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);box-shadow:0 0 50px #fa0;animation:sunP 2s infinite}
    @keyframes sunP{0%,100%{box-shadow:0 0 50px #fa0}50%{box-shadow:0 0 80px #fc4}}
    .orbit{position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.1);animation:spin linear infinite}
    .orbit1{width:80px;height:80px;top:50%;left:50%;transform:translate(-50%,-50%);animation-duration:3s}
    .orbit1::after{content:'';position:absolute;top:5px;left:50%;width:7px;height:7px;background:#38bdf8;border-radius:50%;box-shadow:0 0 10px #38bdf8}
    .orbit2{width:130px;height:130px;top:50%;left:50%;transform:translate(-50%,-50%);animation-duration:5s;animation-direction:reverse}
    .orbit2::after{content:'';position:absolute;top:12px;left:20%;width:9px;height:9px;background:#c084fc;border-radius:50%;box-shadow:0 0 12px #c084fc}
    .orbit3{width:180px;height:180px;top:50%;left:50%;transform:translate(-50%,-50%);animation-duration:7s}
    .orbit3::after{content:'';position:absolute;bottom:15px;right:20%;width:11px;height:11px;background:#f472b6;border-radius:50%;box-shadow:0 0 14px #f472b6}
    @keyframes spin{from{transform:translate(-50%,-50%) rotate(0deg)}to{transform:translate(-50%,-50%) rotate(360deg)}}
    .loading-text{margin-top:25px;text-align:center;color:#8ba0d4;font-size:.6rem;letter-spacing:4px}
    .loading-authors{font-family:'Space Mono',monospace;font-size:.7rem;color:#fff;margin-top:8px;letter-spacing:.5px}
    .top-bar{display:flex;align-items:center;justify-content:space-between;padding:.6rem .8rem;background:rgba(4,8,24,.7);backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);border-radius:1.2rem;border:1px solid rgba(255,255,255,.08);z-index:10;gap:.5rem;flex-wrap:wrap}
    .brand{font-size:.9rem;font-weight:900;letter-spacing:-.5px;background:linear-gradient(180deg,#e0f2fe,#38bdf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .stat{text-align:center}
    .stat-val{font-size:1rem;font-weight:700;color:#f0f4ff}
    .stat-lbl{font-size:.45rem;text-transform:uppercase;letter-spacing:1.5px;color:#6b7fa8}
    .eff-bar{flex:1;min-width:60px}
    .eff-track{height:3px;background:rgba(255,255,255,.1);border-radius:2px;overflow:hidden}
    .eff-fill{height:100%;background:linear-gradient(90deg,#22d3ee,#c084fc);border-radius:2px;transition:width .5s}
    .btn{padding:.5rem .8rem;border-radius:.8rem;font-size:.65rem;font-weight:600;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);color:#dde4f5;cursor:pointer;display:flex;align-items:center;gap:.3rem;transition:all .3s;backdrop-filter:blur(10px);white-space:nowrap}
    .btn:active{transform:scale(.94);background:rgba(34,211,238,.15)}
    .btn-hint{background:linear-gradient(135deg,rgba(30,58,138,.7),rgba(15,23,42,.8));border-color:rgba(34,211,238,.4)}
    .game-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;padding:.8rem 0;flex:1;align-content:start}
    .card-wrap{aspect-ratio:3/4.3;cursor:pointer;position:relative;transition:transform .3s cubic-bezier(.34,1.56,.64,1)}
    .card-wrap:active{transform:scale(.94)}
    .card-inner{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.22,1,.36,1);border-radius:var(--cr)}
    .card-inner.flipped{transform:rotateY(180deg)}
    .card-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:var(--cr);overflow:hidden;box-shadow:0 15px 30px -10px rgba(0,0,0,.8)}
    .card-back{background:radial-gradient(circle at 35% 35%,#1c2a4a,#030818);border:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center}
    .card-back::after{content:'✦';font-size:1.2rem;color:rgba(255,255,255,.15)}
    .card-front{transform:rotateY(180deg);background:#010510;border:1px solid rgba(255,255,255,.15);background-size:cover;background-position:center}
    .card-inner.matched .card-front{border-color:rgba(34,211,238,.6);box-shadow:inset 0 0 30px rgba(34,211,238,.25);animation:matchP 1s ease-out}
    @keyframes matchP{0%{box-shadow:inset 0 0 50px rgba(34,211,238,.6),0 0 30px rgba(34,211,238,.4)}100%{box-shadow:inset 0 0 10px rgba(34,211,238,.1)}}
    .planet-sun{background-image:radial-gradient(circle at 38% 38%,#fef08a,#f59e0b 40%,#b45309)}
    .planet-mercury{background-image:radial-gradient(circle at 38% 38%,#d1d5db,#6b7280 50%,#374151)}
    .planet-venus{background-image:radial-gradient(circle at 42% 42%,#fcd34d,#d97706 45%,#78350f)}
    .planet-earth{background-image:radial-gradient(circle at 38% 38%,#60a5fa,#2563eb 45%,#064e3b)}
    .planet-mars{background-image:radial-gradient(circle at 38% 38%,#f87171,#dc2626 45%,#7f1d1d)}
    .planet-jupiter{background-image:radial-gradient(circle at 38% 38%,#ddd6fe,#8b5cf6 45%,#4c1d95)}
    .planet-saturn{background-image:radial-gradient(circle at 38% 38%,#fef3c7,#d97706 40%,#9d174d)}
    .planet-uranus{background-image:radial-gradient(circle at 38% 38%,#a5f3fc,#0891b2 45%,#164e63)}
    .planet-neptune{background-image:radial-gradient(circle at 38% 38%,#93c5fd,#1d4ed8 45%,#1e3a8a)}
    .planet-moon{background-image:radial-gradient(circle at 38% 38%,#f3f4f6,#9ca3af 50%,#4b5563)}
    .planet-galaxy{background-image:radial-gradient(circle at 38% 38%,#c4b5fd,#7c3aed 45%,#2e1065)}
    .planet-nebula{background-image:radial-gradient(circle at 38% 38%,#f9a8d4,#db2777 45%,#831843)}
    .inv-row{display:flex;gap:.4rem;flex-wrap:wrap;padding:.3rem 0;justify-content:center}
    .inv-badge{width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.04);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.15);background-size:cover;background-position:center;cursor:pointer;transition:all .3s cubic-bezier(.34,1.56,.64,1);animation:popIn .5s cubic-bezier(.34,1.56,.64,1)}
    @keyframes popIn{0%{transform:scale(0)}60%{transform:scale(1.3)}100%{transform:scale(1)}}
    .inv-badge:active{transform:scale(1.2)}
    .modal{position:fixed;inset:0;background:rgba(1,2,14,.9);backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);display:flex;align-items:center;justify-content:center;z-index:100;opacity:0;pointer-events:none;transition:opacity .3s}
    .modal.active{opacity:1;pointer-events:auto}
    .modal-card{background:rgba(8,16,38,.9);backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);border-radius:1.5rem;padding:1.5rem;width:90%;max-width:380px;border:1px solid rgba(255,255,255,.1);color:#fff}
    .stars-display{font-size:2.5rem;letter-spacing:.3rem;animation:starReveal .8s ease-out}
    @keyframes starReveal{0%{transform:scale(0) rotate(-180deg);opacity:0}100%{transform:scale(1) rotate(0deg);opacity:1}}
    .rank-title{font-size:.9rem;letter-spacing:2px;margin:.5rem 0;text-transform:uppercase}
  </style>
</head>
<body>
<div class="stars"></div>
<div id="loading-screen">
  <div class="loader-orbit"><div class="loader-sun"></div><div class="orbit orbit1"></div><div class="orbit orbit2"></div><div class="orbit orbit3"></div></div>
  <div class="loading-text" id="loading-status">Загрузка...</div>
  <div class="loading-authors" id="authors-text"></div>
</div>
<div class="top-bar">
  <div class="brand">✦ КОСМОПАРЫ</div>
  <div class="stat"><div class="stat-val" id="moves">0</div><div class="stat-lbl">Ходов</div></div>
  <div class="stat"><div class="stat-val" id="timer">00:00</div><div class="stat-lbl">Время</div></div>
  <div class="eff-bar"><div class="stat-lbl" style="margin-bottom:2px">Эфф. <span id="eff-pct">100%</span></div><div class="eff-track"><div class="eff-fill" id="eff-fill" style="width:100%"></div></div></div>
  <button class="btn btn-hint" id="hint-btn"><i class="fas fa-sun"></i> <span id="hint-num">2</span></button>
  <button class="btn" onclick="restartGame()"><i class="fas fa-redo"></i></button>
</div>
<div class="inv-row" id="inventory"></div>
<div class="game-grid" id="grid"></div>
<div class="modal" id="info-modal">
  <div class="modal-card">
    <button onclick="closeInfo()" style="float:right;background:none;border:none;color:white;font-size:1.5rem">&times;</button>
    <h3 id="info-title" style="margin-bottom:.8rem"></h3>
    <p id="info-desc" style="color:#bcc8e0;line-height:1.6;font-size:.85rem"></p>
  </div>
</div>
<div class="modal" id="win-modal">
  <div class="modal-card" style="text-align:center">
    <h2 style="font-size:1.2rem;letter-spacing:2px">ГАЛАКТИКА ОТКРЫТА</h2>
    <div class="stars-display" id="win-stars">★★★</div>
    <div class="rank-title" id="rank-title"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin:1rem 0;text-align:left">
      <div style="background:rgba(255,255,255,.04);border-radius:.8rem;padding:.6rem"><span style="font-size:.5rem;color:#6b7fa8">ХОДОВ</span><br><span id="fmoves" style="font-size:.9rem">0</span></div>
      <div style="background:rgba(255,255,255,.04);border-radius:.8rem;padding:.6rem"><span style="font-size:.5rem;color:#6b7fa8">ВРЕМЯ</span><br><span id="ftime" style="font-size:.9rem">00:00</span></div>
      <div style="background:rgba(255,255,255,.04);border-radius:.8rem;padding:.6rem"><span style="font-size:.5rem;color:#6b7fa8">ТОЧНОСТЬ</span><br><span id="facc" style="font-size:.9rem">100%</span></div>
      <div style="background:rgba(255,255,255,.04);border-radius:.8rem;padding:.6rem"><span style="font-size:.5rem;color:#6b7fa8">РЕЙТИНГ</span><br><span id="fscore" style="font-size:.9rem">0</span></div>
    </div>
    <button class="btn" onclick="restartGame()" style="margin:0 auto;width:100%;justify-content:center"><i class="fas fa-globe"></i> Новая миссия</button>
  </div>
</div>
<script>
(function(){
const D=[{id:'sun',n:'Солнце',d:'Центр системы. 15 млн °C.',u:'',c:'planet-sun'},{id:'mercury',n:'Меркурий',d:'Ближайшая к Солнцу.',u:'',c:'planet-mercury'},{id:'venus',n:'Венера',d:'Самая горячая.',u:'',c:'planet-venus'},{id:'earth',n:'Земля',d:'Наш дом. 71% воды.',u:'',c:'planet-earth'},{id:'mars',n:'Марс',d:'Красная планета.',u:'',c:'planet-mars'},{id:'jupiter',n:'Юпитер',d:'Крупнейшая.',u:'',c:'planet-jupiter'},{id:'saturn',n:'Сатурн',d:'Кольца из льда.',u:'',c:'planet-saturn'},{id:'uranus',n:'Уран',d:'Вращается на боку.',u:'',c:'planet-uranus'},{id:'neptune',n:'Нептун',d:'Ветер 2100 км/ч.',u:'',c:'planet-neptune'},{id:'moon',n:'Луна',d:'Спутник Земли.',u:'',c:'planet-moon'},{id:'galaxy',n:'Млечный Путь',d:'Наша галактика.',u:'',c:'planet-galaxy'},{id:'nebula',n:'Туманность',d:'Звёздные ясли.',u:'',c:'planet-nebula'}];
let S={cards:[],flipped:[],matched:0,moves:0,timer:0,interval:null,hints:2,locked:false,started:false};
const T=D.length;
function fmt(t){let m=Math.floor(t/60),s=t%60;return String(m).padStart(2,'0')+':'+String(s).padStart(2,'0')}
function acc(m){return m===0?100:Math.min(100,Math.round((T/m)*100))}
function sc(m,t){let s=10000-(Math.max(0,m-T)*120)-(Math.max(0,t-30)*8);if(t<30)s+=(30-t)*15;if(m<=T)s+=(T-m+1)*200;return Math.max(100,Math.min(12000,Math.round(s)))}
function stars(s){return s>=9000?'★★★★★':s>=7000?'★★★★☆':s>=5000?'★★★☆☆':s>=3000?'★★☆☆☆':'★☆☆☆☆'}
function rank(s){return s>=9500?'Гранд-мастер':s>=8000?'Капитан':s>=6500?'Офицер':s>=5000?'Навигатор':s>=3500?'Пилот':s>=2000?'Кадет':'Турист'}
function rc(s){return s>=8000?'#fbbf24':s>=6000?'#c084fc':s>=4000?'#22d3ee':s>=2000?'#94a3b8':'#ef4444'}
function ue(){if(S.moves===0){document.getElementById('eff-pct').textContent='100%';document.getElementById('eff-fill').style.width='100%';return}let a=acc(S.moves);document.getElementById('eff-pct').textContent=a+'%';document.getElementById('eff-fill').style.width=a+'%';let f=document.getElementById('eff-fill');f.style.background=a>=80?'linear-gradient(90deg,#22d3ee,#c084fc)':a>=50?'linear-gradient(90deg,#fbbf24,#f59e0b)':'linear-gradient(90deg,#f87171,#ef4444)'}
function scC(){if(S.interval)clearInterval(S.interval);S.interval=setInterval(()=>{S.timer++;document.getElementById('timer').textContent=fmt(S.timer)},1000)}
function fl(el){if(S.locked||el.classList.contains('flipped')||el.classList.contains('matched'))return;if(!S.started){S.started=true;scC()}el.classList.add('flipped');S.flipped.push(el);if(S.flipped.length===2){S.moves++;document.getElementById('moves').textContent=S.moves;ue();S.locked=true;chk()}}
function chk(){let[a,b]=S.flipped;if(a.dataset.id===b.dataset.id){a.classList.add('matched');b.classList.add('matched');S.matched++;addI(a.dataset.id);S.flipped=[];S.locked=false;if(S.matched===T)win()}else{setTimeout(()=>{a.classList.remove('flipped');b.classList.remove('flipped');S.flipped=[];S.locked=false},700)}}
function addI(id){if(document.querySelector(`.inv-badge[data-id="${id}"]`))return;let d=D.find(x=>x.id===id);let b=document.createElement('div');b.className='inv-badge';b.dataset.id=id;if(d.u&&d.u.trim()!=='')b.style.backgroundImage=`url(${d.u})`;else b.classList.add(d.c);b.onclick=()=>si(id);document.getElementById('inventory').appendChild(b)}
function si(id){let d=D.find(x=>x.id===id);document.getElementById('info-title').textContent=d.n;document.getElementById('info-desc').textContent=d.d;document.getElementById('info-modal').classList.add('active')}
window.closeInfo=()=>document.getElementById('info-modal').classList.remove('active');
function win(){clearInterval(S.interval);let s=sc(S.moves,S.timer),a=acc(S.moves);document.getElementById('fmoves').textContent=S.moves;document.getElementById('ftime').textContent=fmt(S.timer);document.getElementById('facc').textContent=a+'%';document.getElementById('fscore').textContent=s;document.getElementById('win-stars').textContent=stars(s);let r=document.getElementById('rank-title');r.textContent=rank(s);r.style.color=rc(s);document.getElementById('win-modal').classList.add('active')}
function rst(){clearInterval(S.interval);S={cards:[],flipped:[],matched:0,moves:0,timer:0,interval:null,hints:2,locked:false,started:false};document.getElementById('moves').textContent='0';document.getElementById('timer').textContent='00:00';document.getElementById('hint-num').textContent='2';document.getElementById('eff-pct').textContent='100%';document.getElementById('eff-fill').style.width='100%';document.getElementById('inventory').innerHTML='';document.getElementById('win-modal').classList.remove('active');ue();bld()}
function bld(){let g=document.getElementById('grid');g.innerHTML='';let dk=[...D,...D].sort(()=>Math.random()-.5);dk.forEach(item=>{let w=document.createElement('div');w.className='card-wrap';let i=document.createElement('div');i.className='card-inner';i.dataset.id=item.id;let fb=item.u&&item.u.trim()!==''?`background-image:url('${item.u}');background-size:cover;`:'';i.innerHTML=`<div class="card-face card-front ${(!item.u||item.u.trim()==='')?item.c:''}" style="${fb}"></div><div class="card-face card-back"></div>`;w.appendChild(i);w.addEventListener('click',()=>fl(i));g.appendChild(w);S.cards.push(i)})}
document.getElementById('hint-btn').addEventListener('click',()=>{if(S.locked||S.hints<=0)return;if(!S.started){S.started=true;scC()}S.hints--;document.getElementById('hint-num').textContent=S.hints;S.locked=true;let h=S.cards.filter(c=>!c.classList.contains('matched')&&!c.classList.contains('flipped'));h.forEach(c=>c.classList.add('flipped'));setTimeout(()=>{h.forEach(c=>c.classList.remove('flipped'));S.locked=false},1200)});
window.restartGame=rst;bld();
window.addEventListener('load',()=>{let txt="Авторы: Голосов Д.А. | Баринова С.В. | Климов В.";let el=document.getElementById('authors-text');let i=0;function type(){if(i<txt.length){el.textContent+=txt.charAt(i);i++;setTimeout(type,30)}else{document.getElementById('loading-status').textContent='Готово';setTimeout(()=>{document.getElementById('loading-screen').style.opacity='0';setTimeout(()=>document.getElementById('loading-screen').style.display='none',800)},600)}}setTimeout(type,400)});
document.getElementById('info-modal').addEventListener('click',function(e){if(e.target===this)closeInfo()});
document.getElementById('win-modal').addEventListener('click',function(e){if(e.target===this)this.classList.remove('active')});
})();
</script>
</body>
</html>
